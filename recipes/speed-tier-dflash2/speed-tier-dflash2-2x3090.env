# SPEED TIER — Qwen3.8-27B AutoRound W4A16 + DFlash2 drafter, 2x RTX 3090.
# #1 on the internal 69-scenario agent eval (66/2/1, Quality 97.1, Deployability 97.9).
# Verified on GPU 2/3 of a four-3090 host with an NV4 link.

CONTAINER_NAME=qwen38-dflash2-speed
# The DFlash2 overlay ports vllm-project/vllm#52816 and pins the vLLM version it patches.
VLLM_IMAGE=vllm/vllm-openai:v0.27.1
PORT=8011
GPU_IDS=2,3
# 3090 pairs: custom all-reduce crashes on this hardware even with NVLink, so we
# always pass --disable-custom-all-reduce (NCCL still uses the NVLink transport).
TOPOLOGY=nvlink

# Target (the model that is actually served) — the same W4A16 AutoRound weights as the context tier.
MODEL_REPO=Vishva007/Qwen3.8-27B-W4A16-AutoRound
MODEL_DIR=/home/user/models/qwen3.8-27b-w4a16-autoround
QUANTIZATION=auto_round

# Drafter (proposes tokens; the target verifies them, so output is unchanged) — 3.6 GB.
DRAFTER_REPO=incoai/Qwen3.8-27B-DFlash2
DRAFTER_DIR=/home/user/models/qwen3.8-27b-dflash2
NUM_SPECULATIVE_TOKENS=7

SERVED_MODEL_NAME=qwen3.8-27b

# The DFlash2 codebooks (~0.5 GiB/GPU) + backbone eat prefill headroom, so utilization
# drops to 0.80 (vs 0.90 on the context tier). That shrinks the KV pool to ~258,735
# tokens, so the safe context ceiling is 131,072 (not the native 262,144). Do not raise
# MAX_MODEL_LEN toward 256K here without re-running the memory probe first.
MAX_MODEL_LEN=131072
GPU_MEMORY_UTILIZATION=0.80
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192
KV_CACHE_DTYPE=fp8_e4m3

# W4A8=0 serves the W4A16 path (int8-activation marlin is for the AutoRound INT4 packing;
# leave it off unless you have measured a win on your exact checkpoint).
W4A8=0

MAX_IMAGE_PIXELS=1048576
MIN_IMAGE_PIXELS=65536
READY_TIMEOUT_SECONDS=900
