# Exact profile verified on the reference four-GPU host. Only GPU 2 and 3 are used.
CONTAINER_NAME=qwen38-autoround-int4
VLLM_IMAGE=vllm/vllm-openai:qwen38-x86_64-cu129
PORT=8011
GPU_IDS=2,3
TOPOLOGY=nvlink
MODEL_REPO=Vishva007/Qwen3.8-27B-W4A16-AutoRound
MODEL_DIR=/home/user/models/qwen3.8-27b-w4a16-autoround
SERVED_MODEL_NAME=qwen3.8-27b
MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192
NUM_SPECULATIVE_TOKENS=4
MAX_IMAGE_PIXELS=1048576
MIN_IMAGE_PIXELS=65536
VLLM_CACHE_DIR=/home/user/.cache/vllm
TRITON_CACHE_DIR=/home/user/.cache/triton
REPLACE_CONTAINER=0
READY_TIMEOUT_SECONDS=900
